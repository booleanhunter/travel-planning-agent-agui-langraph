{
    "name": "server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "node --watch --env-file=../.env src/index.ts",
        "dev:agent": "langgraphjs dev --host 127.0.0.1 --port 8123 --no-browser",
        "typecheck": "tsc --noEmit",
        "build": "tsc",
        "start": "node dist/index.js",
        "smoke": "node --env-file=../.env scripts/smoke.ts"
    },
    "dependencies": {
        "@copilotkit/runtime": "^1.57.4",
        "@googlemaps/places": "^2.4.1",
        "@langchain/core": "^1.1.48",
        "@langchain/langgraph": "^1.3.0",
        "@langchain/openai": "^1.4.7",
        "@tavily/core": "^0.7.2",
        "agent-memory-client": "^0.3.1",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^5.1.0",
        "morgan": "^1.10.0",
        "openai": "^6.39.0",
        "redis": "^5.5.6",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@langchain/langgraph-cli": "^1.2.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/morgan": "^1.9.9",
        "@types/node": "^24.0.0",
        "typescript": "^6.0.3"
    }
}
