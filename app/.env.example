# App
APP_NAME="Trip Itinerary Builder"
SERVER_PORT=3000
CLIENT_PORT=5173

# OpenAI
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# Redis (Docker, localhost — overridden by docker-compose for in-container services)
REDIS_URL=redis://localhost:6379

# Redis Agent Memory (Iris) — hosted service, via the @redis-iris/agent-memory
# SDK. serverURL + storeId + apiKey are issued for your Agent Memory service.
AGENT_MEMORY_SERVER_URL=https://<your-agent-memory-endpoint>
AGENT_MEMORY_STORE_ID=<your-store-id>
AGENT_MEMORY_API_KEY=<your-agent-memory-api-key>

# Google Maps Platform — Places API (New)
# Enable in Google Cloud Console: APIs & Services → Places API (New)
GOOGLE_MAPS_API_KEY=

GOOGLE_OAUTH_CLIENT_ID=<the long .apps.googleusercontent.com id>
GOOGLE_OAUTH_CLIENT_SECRET=<the GOCSPX-... secret>
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/google/callback
PUBLIC_BASE_URL=http://localhost:3000

# Tavily — Phase 6 weather + product search
# Get from tavily.com (free tier)
TAVILY_API_KEY=

# LangSmith — optional, for tracing agent workflows
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trip-itinerary-builder
