{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "#modules/*": ["./src/modules/*"],
      "#lib/*": ["./src/lib/*"],
      "#config": ["./src/config.js"]
    }
  },
  "include": ["src/**/*"]
}
